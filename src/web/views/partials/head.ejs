<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <% if (typeof autoRefreshSec !== 'undefined' && autoRefreshSec) { %><meta http-equiv="refresh" content="<%= autoRefreshSec %>"><% } %>
  <title><%= title %> · TikTok Shop Reporting</title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
<header class="topbar">
  <strong>TikTok Shop Reporting</strong>
  <% if (user) { %>
  <nav>
    <a href="/dashboard">Sales</a>
    <% if (user.role === 'admin') { %><a href="/internal">Internal</a><% } %>
    <span class="muted"><%= user.username %> (<%= user.role %>)</span>
    <form method="post" action="/logout" class="inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="link">Log out</button>
    </form>
  </nav>
  <% } %>
</header>
<main>
