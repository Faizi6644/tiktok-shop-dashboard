# ---- Database (MySQL 8) ----
DATABASE_URL=mysql://dash:dashpass@localhost:3306/tiktok_dash

# ---- TikTok Shop app (worker only; the web process never needs the secret) ----
TTS_BASE_URL=http://localhost:4000
TTS_APP_KEY=your_app_key
TTS_APP_SECRET=your_app_secret
# One-time authorization code from the shop owner, used by `npm run connect`
TTS_AUTH_CODE=your_auth_code
TTS_SHOP_ID=your_shop_id
TTS_SHOP_CIPHER=your_shop_cipher

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=replace_with_32_random_bytes_base64

# ---- Hardcoded users (hashed with scrypt by `npm run migrate`) ----
CLIENT_USERNAME=client
CLIENT_PASSWORD=change_me_client
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin

# ---- Web ----
PORT=3000
SESSION_TTL_HOURS=12
# Set to true when served over HTTPS
COOKIE_SECURE=false

# ---- Sync tuning (optional; defaults shown) ----
SYNC_INCREMENTAL_EVERY_SEC=300
SYNC_FULL_EVERY_SEC=86400
SYNC_RETRY_AFTER_FAILURE_SEC=60
RECONCILE_EVERY_SEC=3600
SYNC_LOOKBACK_SEC=600
TTS_MAX_RPM=30
TOKEN_REFRESH_MARGIN_SEC=300
WORKER_TICK_SEC=15

# Optional: alerts (re-auth needed, reconciliation mismatch) are POSTed here as JSON
ALERT_WEBHOOK_URL=
